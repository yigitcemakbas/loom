# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://loom:loom@localhost:5432/loom

# Identifies this app to SEC EDGAR per their fair-access policy. Required — EDGAR
# rejects requests without a real identifying User-Agent. Put your own contact email.
SEC_EDGAR_USER_AGENT="Loom research-tool your-email@example.com"

# Phase 3+: free-tier Finnhub key for company news. Leave blank until then.
FINNHUB_API_KEY=

# Phase 2+: Anthropic API key for the signal-extraction engine. Leave blank until then.
ANTHROPIC_API_KEY=

# Where LocalFileBlobStore writes raw document content.
BLOB_STORE_DIR=./data/blobs
