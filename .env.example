# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://loom:loom@localhost:5432/loom

# Identifies this app to SEC EDGAR per their fair-access policy. Required, EDGAR
# rejects requests without a real identifying User-Agent. Put your own contact email.
SEC_EDGAR_USER_AGENT="Loom research-tool your-email@example.com"

# Identifies Loom to sites it scrapes (earnings call transcripts). Like the SEC
# header above, this is an honest identifying string, never a spoofed browser
# User-Agent. Put your own contact email so a site operator can reach you.
SCRAPER_USER_AGENT="Loom research-tool your-email@example.com"

# Free-tier Finnhub key for company news: https://finnhub.io/register
# Optional. Leave blank and Loom simply skips the news source; filings and
# transcripts still ingest normally.
FINNHUB_API_KEY=

# Background refresh: re-ingest and re-analyse every watchlist ticker on a
# timer, so the dashboard stays current without running a CLI command.
# Set SCHEDULER_ENABLED=false to turn it off (useful on a metered LLM tier).
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=360
SCHEDULER_STARTUP_DELAY_SECONDS=120

# Which LLM backs the analysis engine: "gemini" (free tier) or "anthropic" (paid).
LLM_PROVIDER=gemini

# Free key from https://aistudio.google.com/apikey, needed when LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# Paid key from console.anthropic.com, needed only when LLM_PROVIDER=anthropic.
# Note: a Claude Pro subscription does NOT cover API usage; these are billed separately.
ANTHROPIC_API_KEY=

# Where LocalFileBlobStore writes raw document content.
BLOB_STORE_DIR=./data/blobs

# Minimum gap between LLM requests, to stay under a per-minute quota rather than
# repeatedly hitting it and paying the backoff. Gemini's free tier allows roughly
# ten requests a minute. Set 0 to disable pacing (appropriate on a paid tier).
LLM_MIN_CALL_INTERVAL_SECONDS=6.5
